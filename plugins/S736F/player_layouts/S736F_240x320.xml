<component>
    <animations>
        <timeline name="lyrics_open">
            <animation prop="opa" target="artist" start="255" end="0" duration="180" />
            <animation prop="opa" target="title" start="255" end="0" duration="180" />
            <animation prop="opa" target="cover_card" start="255" end="0" duration="180" />
            <animation prop="opa" target="song_count" start="255" end="0" duration="180" />
            <animation prop="opa" target="quality_pill" start="255" end="0" duration="180" />
            <animation prop="opa" target="favorite_circle" start="255" end="0" duration="180" />
            <animation prop="opa" target="order_btn" start="255" end="0" duration="180" />
            <animation prop="opa" target="album" start="255" end="0" duration="180" />
            <animation prop="opa" target="dismiss_btn" start="255" end="0" duration="80" />
        </timeline>
        <timeline name="lyrics_close">
            <animation prop="opa" target="artist" start="0" end="255" duration="180" />
            <animation prop="opa" target="title" start="0" end="255" duration="180" />
            <animation prop="opa" target="cover_card" start="0" end="255" duration="180" />
            <animation prop="opa" target="song_count" start="0" end="255" duration="180" />
            <animation prop="opa" target="quality_pill" start="0" end="255" duration="180" />
            <animation prop="opa" target="favorite_circle" start="0" end="255" duration="180" />
            <animation prop="opa" target="order_btn" start="0" end="255" duration="180" />
            <animation prop="opa" target="album" start="0" end="255" duration="180" />
            <animation prop="opa" target="dismiss_btn" start="0" end="255" duration="80" />
        </timeline>
    </animations>
    <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false" style_bg_color="0x000000" style_bg_opa="0" style_text_color="0xffffff" style_border_width="0" style_radius="0" style_pad_all="0">
        <lv_obj name="dismiss_btn" x="0" y="2" width="32" height="32" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="dismiss_icon" src="v1_back" x="4" y="4" width="24" height="24" inner_align="contain" />
        </lv_obj>
        <lv_obj name="cover_card" x="12" y="38" width="96" height="96" scrollable="false" style_radius="12" style_clip_corner="true" style_bg_color="0x000000" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_image name="cover_img" src="default_cover" width="100%" height="100%" align="center" inner_align="cover" />
        </lv_obj>
        <lv_label name="title" text="" x="120" y="43" width="108" height="content" style_text_font="font_16" style_text_color="0xffffff" style_text_align="left" style_pad_all="0" />
        <lv_label name="artist" text="" x="120" y="73" width="108" height="content" style_text_font="font_16" style_text_color="0xe6e6e6" style_text_align="left" style_pad_all="0" />
        <lv_label name="album" text="" x="120" y="103" width="108" height="content" style_text_font="font_16" style_text_color="0xb0b0b0" style_text_align="left" style_pad_all="0" />
        <lv_label name="song_count" text="" x="120" y="137" width="108" height="content" style_text_font="font_16" style_text_color="0xaab1b8" style_text_align="left" style_pad_all="0" />
        <lv_obj name="quality_pill" x="12" y="194" width="216" height="22" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_label name="format_badge" text="" x="0" y="1" width="100%" height="20" long_mode="dots" style_text_font="font_16" style_text_color="0x9a9a9a" style_text_align="left" style_pad_all="0" />
        </lv_obj>
        <lv_image name="order_btn" src="order" x="120" y="160" width="24" height="24" inner_align="contain" />
        <lv_obj name="favorite_circle" x="156" y="158" width="32" height="32" scrollable="false" style_radius="16" style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="favorite_icon" src="collect_out" width="24" height="24" align="center" inner_align="contain" />
        </lv_obj>
        <lv_obj name="lyrics_area" x="12" y="45" width="216" height="164" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_text_color="0xb9b9b9" style_text_align="center" clickable="false" />
        <lv_slider name="progress_slider" x="12" y="222" width="216" height="8" style_radius="4" />
        <lv_label name="pos_label" text="0:00" x="12" y="235" width="72" height="content" style_text_font="font_16" style_text_color="0x9a9a9a" style_text_align="left" style_pad_all="0" />
        <lv_label name="dur_label" text="--:--" x="156" y="235" width="72" height="content" style_text_font="font_16" style_text_color="0x9a9a9a" style_text_align="right" style_pad_all="0" />
        <lv_image name="more_btn" src="ic_more" x="204" y="274" width="24" height="24" inner_align="contain" />
        <lv_image name="prev_btn" src="btn_prev" x="60" y="274" width="24" height="24" inner_align="contain" />
        <lv_obj name="play_circle" x="102" y="267" width="38" height="38" scrollable="false" style_radius="19" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_image name="play_btn" src="btn_play" x="0" y="0" width="38" height="38" inner_align="contain" />
        </lv_obj>
        <lv_image name="next_btn" src="btn_next" x="156" y="274" width="24" height="24" inner_align="contain" />
        <lv_slider name="volume_slider" width="100" height="10" hidden="true" />
    </view>
</component>
