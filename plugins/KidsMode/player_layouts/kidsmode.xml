<component>
    <consts>
        <bool name="compas_lyrics_enabled" value="false" />
        <str name="compas_artist_action" value="none" />
        <str name="compas_album_action" value="none" />
    </consts>

    <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false" style_bg_color="0x10242d" style_bg_opa="255" style_border_width="0" style_radius="0" style_pad_all="0">
        <lv_obj name="lyrics_backdrop" x="0" y="32" width="480" height="536" scrollable="false" clickable="false" style_bg_color="0x10242d" style_bg_opa="255" style_border_width="0" style_radius="0" style_pad_all="0">
            <lv_obj name="cover_card" x="0" y="0" width="480" height="480" scrollable="false" style_radius="0" style_clip_corner="true" style_bg_color="0x10242d" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
                <lv_image name="plugin_track_image" align="center" />
                <lv_image name="cover_img" src="default_cover" hidden="true" align="center" />
                <lv_image name="cover_fade" x="0" y="0" width="480" height="480" inner_align="stretch" />
            </lv_obj>
            <lv_obj name="lyrics_dim" x="0" y="0" width="480" height="480" scrollable="false" clickable="false" style_bg_color="0x10242d" style_bg_opa="0" style_opa="255" style_border_width="0" style_radius="0" style_pad_all="0" />
            <lv_obj name="lyrics_area" x="18" y="128" width="444" height="408" scrollable="false" style_bg_color="0x10242d" style_bg_opa="0" style_opa="255" style_radius="20" style_border_width="0" style_pad_all="12" style_text_color="0xc2d0d3" style_text_align="left" clickable="false" />
        </lv_obj>
        <lv_obj name="dismiss_btn" x="8" y="32" width="44" height="44" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="dismiss_icon" src="btn_back" x="10" y="10" width="24" height="24" inner_align="contain" />
        </lv_obj>
        <lv_label name="title" text="" x="24" y="414" width="432" height="content" style_text_font="player_title" style_text_color="0xf2f7f8" style_text_align="left" style_pad_all="0" clickable="false" />
        <lv_label name="artist" text="" x="24" y="458" width="432" height="content" style_text_font="font_16" style_text_color="0xc2d0d3" style_text_align="left" style_pad_all="0" clickable="false" />
        <lv_label name="album" text="" x="24" y="486" width="432" height="content" style_text_font="font_16" style_text_color="0x9aadb1" style_text_align="left" style_pad_all="0" clickable="false" />
        <lv_image name="cover_thumbnail" src="default_cover" x="24" y="64" width="56" height="56" inner_align="contain" style_opa="0" />
        <lv_label name="song_count" text="" x="24" y="528" width="58" height="content" style_text_font="font_16" style_text_color="0xc2d0d3" style_pad_all="0" />

        <lv_label name="seek_style" x="0" y="0" width="1" height="1" style_opa="0" clickable="false" text="waveform_bars" />
        <lv_slider name="progress_slider" x="24" y="580" width="432" height="30" style_bg_color="0x789096" style_bg_opa="255" style_radius="7" />
        <lv_label name="pos_label" text="0:00" x="24" y="614" width="100" height="content" style_text_font="font_16" style_text_color="0xc2d0d3" style_pad_all="0" />
        <lv_label name="dur_label" text="--:--" x="356" y="614" width="100" height="content" style_text_font="font_16" style_text_color="0xc2d0d3" style_text_align="right" style_pad_all="0" />
        <lv_image name="prev_btn" src="btn_prev" x="124" y="680" width="40" height="40" inner_align="contain" />
        <lv_obj name="play_circle" x="198" y="658" width="84" height="84" scrollable="false" style_radius="100" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_image name="play_btn" src="btn_play" x="0" y="0" width="84" height="84" inner_align="contain" />
        </lv_obj>
        <lv_image name="next_btn" src="btn_next" x="316" y="680" width="40" height="40" inner_align="contain" />
        <lv_slider name="volume_slider" width="100" height="10" hidden="true" />
    </view>
</component>
