        <lv_obj name="lyrics_dim" x="0" y="0" width="#screen_w" height="#screen_h" scrollable="false" clickable="false" style_opa="0" style_radius="0" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" style_pad_all="0" />
