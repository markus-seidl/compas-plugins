        <lv_image name="more_btn" src="ic_more" x="200" y="272" width="32" height="32" inner_align="contain" />
        <lv_label name="title" text="" x="12" y="132" width="216" height="content" style_text_font="font_20" style_text_color="0xf2f3f4" style_text_align="center" style_pad_all="0" long_mode="clip" />
        <lv_label name="artist" text="" x="12" y="158" width="216" height="content" style_text_font="font_16" style_text_color="0xdde2e6" style_text_align="center" style_pad_all="0" long_mode="clip" />
        <lv_label name="album" text="" x="12" y="180" width="216" height="content" style_text_font="font_16" style_text_color="0xdde2e6" style_text_align="center" style_pad_all="0" long_mode="clip" />
        <lv_label name="song_count" text="" x="96" y="247" width="48" height="20" style_text_font="font_16" style_text_color="0xdde2e6" style_text_align="center" style_pad_all="0" />
