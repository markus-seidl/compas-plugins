<component>
    <animations>
        <timeline name="lyrics_open">
            <animation prop="translate_y" target="title" start="0" end="-104" duration="240" />
            <animation prop="translate_y" target="artist" start="0" end="-104" duration="240" />
            <animation prop="translate_y" target="album" start="0" end="-104" duration="240" />
            <animation prop="opa" target="lyrics_dim" start="0" end="170" duration="240" />
            <animation prop="opa" target="quality_pill" start="255" end="0" duration="180" />
            <animation prop="opa" target="song_count" start="255" end="0" duration="180" />
            <animation prop="opa" target="favorite_circle" start="255" end="0" duration="180" />
            <animation prop="opa" target="dismiss_btn" start="255" end="0" duration="80" />
        </timeline>
        <timeline name="lyrics_close">
            <animation prop="translate_y" target="title" start="-104" end="0" duration="240" />
            <animation prop="translate_y" target="artist" start="-104" end="0" duration="240" />
            <animation prop="translate_y" target="album" start="-104" end="0" duration="240" />
            <animation prop="opa" target="lyrics_dim" start="170" end="0" duration="240" />
            <animation prop="opa" target="quality_pill" start="0" end="255" duration="180" />
            <animation prop="opa" target="song_count" start="0" end="255" duration="180" />
            <animation prop="opa" target="favorite_circle" start="0" end="255" duration="180" />
            <animation prop="opa" target="dismiss_btn" start="0" end="255" duration="80" />
        </timeline>
    </animations>
    <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false" style_bg_color="0x090d11" style_bg_opa="255" style_text_color="0xf2f3f4" style_border_width="0" style_radius="0" style_pad_all="0">
        <lv_obj name="cover_card" x="0" y="0" width="#screen_w" height="#screen_h" scrollable="false" style_radius="0" style_clip_corner="true" style_bg_color="0x090d11" style_bg_opa="255" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_image name="cover_img" src="default_cover" width="100%" height="100%" align="center" inner_align="cover" />
            <lv_image name="cover_fade" x="0" y="0" width="100%" height="100%" inner_align="stretch" />
        </lv_obj>
        <lv_obj name="scrim_top" x="0" y="0" width="100%" height="88" scrollable="false" clickable="false" style_radius="0" style_bg_color="0x000000" style_bg_opa="44" style_border_width="0" style_pad_all="0" />
